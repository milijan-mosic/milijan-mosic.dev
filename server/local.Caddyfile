app.moss.local {
	tls internal

	encode zstd gzip

	header {
		Referrer-Policy "no-referrer"
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "deny"
		# NOTE: Strict-Transport-Security is deliberately NOT set here, unlike
		# server/Caddyfile. `tls internal` issues a cert from Caddy's own CA,
		# which the browser doesn't trust — and HSTS removes the "proceed
		# anyway" bypass for untrusted certs, making the site unreachable.
		# A 2-year max-age would also pin app.moss.local long after testing.
		#
		# The headers below are kept identical to server/Caddyfile so the CSP
		# is exercised locally. See that file for why each directive differs
		# from the v1 policy.
		# Must stay on ONE line: Go's HTTP/2 and HTTP/3 servers silently drop a
		# header whose value contains a newline (HTTP/1.1 turns it into spaces),
		# so a multi-line policy never reaches the browser.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google.com https://www.gstatic.com; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.google.com; img-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com data:; frame-src https://www.google.com; manifest-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self'; font-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none';"
		-Last-Modified
		-Server
	}

	# Everything goes to `vite dev`, including its hot-reload WebSocket (which
	# reverse_proxy upgrades transparently). The Cache-Control rules and static
	# file_server from server/Caddyfile are left out on purpose: in dev, cached
	# files would hide your edits, and there is no prerendered build to serve.
	# The 404 page is rendered by the app's catch-all route instead.
	reverse_proxy mm_dev_app:40000
}

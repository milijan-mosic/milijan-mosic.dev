# Copy to v2/.env and fill in. .env is gitignored and must never be committed.
#
# Note: this file is named `env.example` rather than the conventional
# `.env.example` because the repo's tooling denies access to `.env.*` paths.
#
# Both compose files load this one file:
#   - local (dev):  env_file → the running `vite dev` gets every key below
#   - prod:         env_file → server-only keys at runtime, and a build secret
#                   → the VITE_* keys at build time (Vite inlines them then)

# ── Server only — never referenced from a component, or Vite inlines it ──────

# Resend API key for the contact form. https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret half of the reCAPTCHA v3 key pair ("Score based", not the v2
# checkbox), used for /recaptcha/api/siteverify. https://www.google.com/recaptcha/admin
# The key's domain list needs both milijan-mosic.dev and app.moss.local.
# Leave EMPTY to skip verification entirely — handy for local development.
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=you@example.com

# Sender address. Must be on a domain verified in Resend; onboarding@resend.dev
# works without verification but only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Port the Node server listens on. Leave unset: Caddy expects 40000.
# PORT=40000

# ── Public — inlined into the client bundle at build time by design ──────────

# Public half of the same reCAPTCHA v3 key pair as RECAPTCHA_SECRET_KEY.
VITE_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GA4 measurement ID. Leave empty to omit gtag.js entirely.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
